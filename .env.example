# 收件箱引擎 · 环境变量
# 复制成 .env 后按实际情况填。这个文件不要提交到 git。

# ---- Telegram ----
# 只跑飞书可以不填 TOKEN；两个都填就是双通道
TOKEN=
PROXY=http://127.0.0.1:10808
CHAT_ID=

# ---- 飞书（可选，国内直连，不需要代理）----
# 开放平台 → 自建应用 → 机器人 → 长连接事件 im.message.receive_v1
# 权限：im:message、im:message:send_as_bot、im:chat:readonly
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ---- 知识库 ----
# 四层结构所在位置，建议用绝对路径
KB_ROOT=

# 每次入库后是否自动 push 到远端（默认开；设 0 关掉）
# AUTO_PUSH=1

# ---- 视频（可选，不跑视频可以不填）----
# 浏览器导出的 cookies.txt 路径；B站有 AI 字幕，比 ASR 准得多
# VIDEO_COOKIES=
# 直接从浏览器读 cookie，例如 firefox（需先在该浏览器登录对应网站）
# VIDEO_COOKIES_FROM_BROWSER=
# small（默认）/ medium（更准更慢）
# WHISPER_MODEL=small
# 跳过语言检测
# WHISPER_LANG=zh
# 长视频上限，秒
# VIDEO_MAX_DURATION=7200
# 强制关键帧数量
# VIDEO_MAX_FRAMES=
# 场景变化灵敏度，调低会抓更多切换点
# VIDEO_SCENE_THRESHOLD=0.30
# 关键帧母版：最长边（默认 1080）和 JPEG 质量（默认 84）
# VIDEO_FRAME_MAX_WIDTH=1080
# VIDEO_FRAME_QUALITY=84
# 手机看的自包含 HTML：1 生成 / 0 不生成；里面图片是压缩预览
# VIDEO_HTML=1
# VIDEO_HTML_MAX_WIDTH=900
# VIDEO_HTML_QUALITY=68
